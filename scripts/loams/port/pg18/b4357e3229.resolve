+			break;
+		case DISPATCH_NEON_SYNCWAL:
+			CallExtMain("neon", "WalProposerSync", argc, argv, true);
+			break;
 		case DISPATCH_POSTMASTER:
 			PostmasterMain(argc, argv);
 			break;
