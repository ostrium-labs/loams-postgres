From dad9858afcd5e7d3486aa18198fabef1287df08c Mon Sep 17 00:00:00 2001
From: Dinakaran <dinakaranvijayakumar@outlook.com>
Date: Thu, 29 Oct 2026 13:41:08 +0530
Subject: [PATCH] loams-pg18: build fixes for the ported series at 18.6

Three call sites the 17 series did not know about:
- RelationCopyStorageUsingBuffer's read stream opens the source with
  smgropen(), which takes a relpersistence in our smgr API (18 added
  that call).
- 18.6's second _bt_get_endpoint() call for an empty index under
  serializable isolation passes the parent block Neon's index-only
  prefetch takes.
- pg_dump's getEventTriggers() returns nothing at 18, so
  --no-event-triggers returns early without a count.

Loams-Patch: LP-0038
Signed-off-by: Dinakaran <dinakaranvijayakumar@outlook.com>
---
 src/backend/access/nbtree/nbtsearch.c | 3 ++-
 src/backend/storage/buffer/bufmgr.c   | 3 ++-
 src/bin/pg_dump/pg_dump.c             | 3 +--
 3 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/src/backend/access/nbtree/nbtsearch.c b/src/backend/access/nbtree/nbtsearch.c
index 445abe6..94a7a0a 100644
--- a/src/backend/access/nbtree/nbtsearch.c
+++ b/src/backend/access/nbtree/nbtsearch.c
@@ -2940,7 +2940,8 @@ _bt_endpoint(IndexScanDesc scan, ScanDirection dir)
 		{
 			PredicateLockRelation(rel, scan->xs_snapshot);
 			so->currPos.buf = _bt_get_endpoint(rel, 0,
-											   ScanDirectionIsBackward(dir));
+											   ScanDirectionIsBackward(dir),
+											   &parent);
 		}
 
 		if (!BufferIsValid(so->currPos.buf))
diff --git a/src/backend/storage/buffer/bufmgr.c b/src/backend/storage/buffer/bufmgr.c
index eb3a71e..e9ece21 100644
--- a/src/backend/storage/buffer/bufmgr.c
+++ b/src/backend/storage/buffer/bufmgr.c
@@ -5238,7 +5238,8 @@ RelationCopyStorageUsingBuffer(RelFileLocator srclocator,
 	/* Initialize streaming read */
 	p.current_blocknum = 0;
 	p.last_exclusive = nblocks;
-	src_smgr = smgropen(srclocator, INVALID_PROC_NUMBER);
+	src_smgr = smgropen(srclocator, INVALID_PROC_NUMBER,
+						permanent ? RELPERSISTENCE_PERMANENT : RELPERSISTENCE_UNLOGGED);
 
 	/*
 	 * It is safe to use batchmode as block_range_read_stream_cb takes no
diff --git a/src/bin/pg_dump/pg_dump.c b/src/bin/pg_dump/pg_dump.c
index e3f3d70..8419589 100644
--- a/src/bin/pg_dump/pg_dump.c
+++ b/src/bin/pg_dump/pg_dump.c
@@ -8747,8 +8747,7 @@ getEventTriggers(Archive *fout)
 	if (fout->dopt->no_event_triggers)
 	{
 		pg_log_info("skipping event triggers");
-		*numEventTriggers = 0;
-		return NULL;
+		return;
 	}
 
 	query = createPQExpBuffer();
-- 
2.55.0

