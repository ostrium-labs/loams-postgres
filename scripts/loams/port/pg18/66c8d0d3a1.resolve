 		/*
 		 * Reject attempts to extend non-local temporary relations; we have no
@@ -4606,7 +4606,7 @@
 	rlocator = smgr_reln->smgr_rlocator;
 
 	/* If it's a local relation, it's localbuf.c's problem. */
