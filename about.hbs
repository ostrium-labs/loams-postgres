<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Loams Postgres: third-party licences</title>
<style>
body { font-family: sans-serif; max-width: 60em; margin: 2em auto; padding: 0 1em; }
pre { white-space: pre-wrap; background: #f6f6f6; padding: 1em; }
</style>
</head>
<body>
<h1>Third-party licences</h1>
<p>Loams Postgres (https://github.com/ostrium-labs/loams-postgres) is built from
these Rust crates. Generated by cargo-about from about.toml (LP-0010).</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>Licences</h2>
{{#each licenses}}
<section>
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</section>
{{/each}}
</body>
</html>
